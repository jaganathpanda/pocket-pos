rules_version = '2';

// Pocket POS multi-tenant rules.
//
// Tenancy model: every store's data lives under `stores/{storeId}/...` and is
// reachable only by that store's members (`stores/{storeId}/users/{uid}`), by a
// platform admin, or — for the public storefront — by the holder of a scoped
// `customer_cart` custom token minted by the Apps Script cart-session endpoint.
//
// Platform weighbridge operators (docs in /weighbridge_operators/{uid}, once
// approved) may read a mill's catalog and create PENDING vehicle entries in
// any store; only store members can approve them.
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // AUTHENTICATION HELPERS
    // ──────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    // Is the caller a member of this store (owner/staff)?
    function isStoreMember(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid));
    }

    // Is the caller an approved platform weighbridge operator?
    function isApprovedOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/weighbridge_operators/$(request.auth.uid))
        && get(/databases/$(database)/documents/weighbridge_operators/$(request.auth.uid)).data.status == 'approved';
    }

    // A scoped public-storefront session. Explicitly forces both sides of the
    // cartId check to STRING to prevent type-cast mismatch: the token claim
    // arrives as a number while the cart's document id is a string.
    function isCustomerCartToken(storeId, cartId) {
      return isSignedIn()
        && request.auth.token.role == 'customer_cart'
        && string(request.auth.token.storeId) == string(storeId)
        && string(request.auth.token.cartId) == string(cartId);
    }

    function isCustomerCart() {
      return isSignedIn() && request.auth.token.role == 'customer_cart';
    }

    // Weighbridge is a rice-mill-only feature.
    function isRiceMill(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.businessType == 'riceMill';
    }
    // ──────────────────────────────────────────────────────────────────────
    // EMAIL INDEX (Registration support)
    // ──────────────────────────────────────────────────────────────────────


    match /email_index/{emailKey} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
      allow list, update: if isPlatformAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // USER STORE INDEX
    // ──────────────────────────────────────────────────────────────────────

    match /user_store_index/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // PLATFORM ADMINS
    // ──────────────────────────────────────────────────────────────────────

    match /platform_admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if isPlatformAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // WEIGHBRIDGE OPERATORS
    // ──────────────────────────────────────────────────────────────────────

    match /weighbridge_operators/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'weighbridgeOperator';
      allow update: if isPlatformAdmin()
        || (isSignedIn() 
            && request.auth.uid == uid 
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending');
      allow delete: if isPlatformAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // PLATFORM CONFIG
    // ──────────────────────────────────────────────────────────────────────

  // Platform config — platform admins only.
    match /platform_config/{docId} {
      allow get: if isPlatformAdmin()
                  || (isSignedIn() && docId == 'referral_settings');
      allow list, write: if isPlatformAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // REFERRAL SYSTEM
    // ──────────────────────────────────────────────────────────────────────

    // Platform-level user documents (for referral codes, rewards, etc.)
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow list: if isPlatformAdmin();
    }

    // Referral records (platform-wide)
    match /referral/{referralId} {
      allow read, write: if isSignedIn();
    }
    

    // ──────────────────────────────────────────────────────────────────────
    // STORES
    // ──────────────────────────────────────────────────────────────────────

    match /stores/{storeId} {

      allow create: if isSignedIn()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.storeId == storeId;

      allow get: if isStoreMember(storeId)
                 || isPlatformAdmin()
                 || isApprovedOperator()
                 || isCustomerCart();

      allow list: if isPlatformAdmin();

      allow update: if isPlatformAdmin()
                    || (isStoreMember(storeId)
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isPlatformAdmin();

      // ────────────────────────────────────────────────────────────────────
      // STORE USER DIRECTORY
      // ────────────────────────────────────────────────────────────────────

      match /users/{uid} {
        allow read: if isStoreMember(storeId) 
                    || isPlatformAdmin() 
                    || isApprovedOperator();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if isStoreMember(storeId) || isPlatformAdmin();
      }
      // ────────────────────────────────────────────────────────────────────
      // CATALOG (Read-only for operators)
      // ────────────────────────────────────────────────────────────────────

      match /products/{id} {
        allow read: if isStoreMember(storeId) 
                    || isPlatformAdmin() 
                    || isApprovedOperator()
                    || isCustomerCart();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      match /suppliers/{id} {
        allow read: if isStoreMember(storeId) 
                    || isPlatformAdmin() 
                    || isApprovedOperator();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      match /warehouses/{id} {
        allow read: if isStoreMember(storeId) 
                    || isPlatformAdmin() 
                    || isApprovedOperator();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // CARTS
      // ────────────────────────────────────────────────────────────────────

      match /carts/{cartId} {
        allow read: if isStoreMember(storeId)
                   || isPlatformAdmin()
                   || isCustomerCartToken(storeId, cartId);

        allow create, update, delete: if isStoreMember(storeId)
                                       || isCustomerCartToken(storeId, cartId);
      }

      // ────────────────────────────────────────────────────────────────────
      // CART ITEMS
      // ────────────────────────────────────────────────────────────────────

      match /cart_items/{itemId} {
        allow read: if isStoreMember(storeId)
                   || isPlatformAdmin()
                   || isCustomerCartToken(storeId, resource.data.cartId);

        allow create: if isStoreMember(storeId)
                     || isCustomerCartToken(storeId, request.resource.data.cartId);

        allow update, delete: if isStoreMember(storeId)
                             || isCustomerCartToken(storeId, resource.data.cartId);
      }

      // ────────────────────────────────────────────────────────────────────
      // VEHICLE ENTRIES ✅ COMPLETE RULES
      // ────────────────────────────────────────────────────────────────────

      match /vehicle_entries/{entryId} {
        // ── READ ──
        allow read: if isStoreMember(storeId)
          || isPlatformAdmin()
          || (isApprovedOperator()
              && resource.data.createdByUid == request.auth.uid);

        // ── CREATE ── ✅ ADDED
        allow create: if isStoreMember(storeId)
          || isPlatformAdmin()
          || (isApprovedOperator()
              && request.resource.data.status == 'pending'
              && request.resource.data.createdByUid == request.auth.uid
              && request.resource.data.createdByRole == 'weighbridgeOperator'
              && isRiceMill(storeId));

        // ── UPDATE ── ✅ ADDED
        allow update: if isStoreMember(storeId)
          || isPlatformAdmin()
          || (isApprovedOperator()
              && resource.data.createdByUid == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.createdByUid == request.auth.uid);

        // ── DELETE ── ✅ ADDED
        allow delete: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // NOTIFICATIONS
      // ────────────────────────────────────────────────────────────────────

      match /notifications/{id} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin();
        allow create: if isStoreMember(storeId) 
                      || isPlatformAdmin() 
                      || isApprovedOperator();
        allow update, delete: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // FARMERS
      // ────────────────────────────────────────────────────────────────────

      match /farmers/{id} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin() || isApprovedOperator();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // PADDY PROCUREMENT
      // ────────────────────────────────────────────────────────────────────

      match /paddy_procurement/{id} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // MILL RUNS
      // ────────────────────────────────────────────────────────────────────

      match /mill_runs/{id} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // MILLING CHARGES
      // ────────────────────────────────────────────────────────────────────

      match /milling_charges/{id} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin();
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // ────────────────────────────────────────────────────────────────────
      // FALLBACK
      // ────────────────────────────────────────────────────────────────────

      match /{document=**} {
        allow read, write: if isStoreMember(storeId) || isPlatformAdmin();
      }
    }
  }
}